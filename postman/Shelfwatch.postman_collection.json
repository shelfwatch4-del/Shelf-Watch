{
  "info": {
    "name": "Shelfwatch API",
    "description": "Shelfwatch: Retail Product Demand Estimation and Stockout Risk Analysis. Set the collection variables baseUrl (for example http://localhost:8000 or your public ngrok URL, no trailing slash) and apiKey (the API_KEY from .env). Run the folders in order. Inventory levels are simulated.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8000"
    },
    {
      "key": "apiKey",
      "value": "YOUR_API_KEY"
    },
    {
      "key": "orderId",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "00 mentor flow",
      "item": [
        {
          "name": "GET /health",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status 200\", () => pm.response.to.have.status(200));",
                  "const j = pm.response.json();",
                  "pm.test(\"status is ok\", () => pm.expect(j.status).to.eql(\"ok\"));",
                  "pm.test(\"database connected\", () => pm.expect(j.database.connected).to.eql(true));",
                  "pm.test(\"tables listed with counts\", () => pm.expect(Object.keys(j.database.tables).length).to.be.above(0));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "ngrok-skip-browser-warning",
                "value": "true"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/health",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "health"
              ]
            }
          }
        },
        {
          "name": "POST /predict",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status 200\", () => pm.response.to.have.status(200));",
                  "const j = pm.response.json();",
                  "pm.test(\"has forecast and risk fields\", () => {",
                  "  pm.expect(j).to.have.property(\"forecast_weekly\");",
                  "  pm.expect(j).to.have.property(\"risk_level\");",
                  "  pm.expect(j).to.have.property(\"action\");",
                  "});",
                  "pm.test(\"risk_level is HIGH, MEDIUM or LOW\", () => pm.expect([\"HIGH\",\"MEDIUM\",\"LOW\"]).to.include(j.risk_level));",
                  "pm.test(\"p10 <= forecast <= p90\", () => {",
                  "  pm.expect(j.forecast_p10).to.be.at.most(j.forecast_weekly);",
                  "  pm.expect(j.forecast_weekly).to.be.at.most(j.forecast_p90);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "ngrok-skip-browser-warning",
                "value": "true"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/predict",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "predict"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"product_id\": \"85123A\",\n  \"lead_time_weeks\": 1,\n  \"service_level\": 0.95,\n  \"on_hand\": null\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        }
      ]
    },
